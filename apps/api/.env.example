# Copiar como .env y completar. NUNCA subir .env al repo.

PORT=3101
WEB_ORIGIN=http://localhost:3100

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Connect → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres

# Solo para el script seed:users (Supabase → Project Settings → API Keys → Secret key).
# Nunca la uses en el frontend.
SUPABASE_SECRET_KEY=
# SEED_PASSWORD=MotoSpa2026!
